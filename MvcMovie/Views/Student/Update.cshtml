@model MvcMovie.Models.Student

@{
    ViewData["Title"] = "Sửa Sinh viên";
}

<h1>Sửa thông tin Sinh viên</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="StudentId" />

            <div class="form-group mb-3">
                <label class="control-label">Mã Sinh Viên</label>
                <input value="@Model?.StudentId" class="form-control" readonly />
            </div>

            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="University" class="control-label"></label>
                <input asp-for="University" class="form-control" />
                <span asp-validation-for="University" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NamNhapHoc" class="control-label"></label>
                <select asp-for="NamNhapHoc" class="form-control" asp-items="@((IEnumerable<SelectListItem>)ViewBag.NamNhapHoc)">
                    <option value="">-- Chọn năm nhập học --</option>
                </select>
                <span asp-validation-for="NamNhapHoc" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="HeDaoTao" class="control-label"></label>
                <select asp-for="HeDaoTao" class="form-control" asp-items="@((IEnumerable<SelectListItem>)ViewBag.HeDaoTao)">
                    <option value="">-- Chọn hệ đào tạo --</option>
                </select>
                <span asp-validation-for="HeDaoTao" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FacultyId" class="control-label">Ngành học (Khoa)</label>
                <select asp-for="FacultyId" class="form-control" asp-items="@((SelectList)ViewBag.FacultyId)">
                    <option value="">-- Chọn ngành học / khoa --</option>
                </select>
                <span asp-validation-for="FacultyId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Quay lại danh sách</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
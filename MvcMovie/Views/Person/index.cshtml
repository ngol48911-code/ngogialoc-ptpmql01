@{
    ViewData["Title"] = "Danh sách Person";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Danh sách Person</h1>
    <button type="button" class="btn btn-primary" id="createPersonButton">Thêm Person</button>
</div>

<div id="personAlert" class="alert d-none" role="alert"></div>

<div class="row g-2 mb-3">
    <div class="col-md-10">
        <input id="personSearch" class="form-control" placeholder="Tìm mã, họ tên hoặc địa chỉ..." />
    </div>
    <div class="col-md-2">
        <select id="personPageSize" class="form-select" aria-label="Số dòng mỗi trang">
            <option value="5">5 dòng</option>
            <option value="10" selected>10 dòng</option>
            <option value="20">20 dòng</option>
        </select>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Mã Person</th>
            <th>Họ và tên</th>
            <th>Địa chỉ</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody id="personTableBody">
        <tr><td colspan="4" class="text-center">Đang tải dữ liệu...</td></tr>
    </tbody>
</table>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span id="personPageInfo" class="text-muted"></span>
    <nav aria-label="Phân trang Person">
        <ul id="personPagination" class="pagination mb-0"></ul>
    </nav>
</div>

<div class="modal fade" id="personModal" tabindex="-1" aria-labelledby="personModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="personModalLabel">Thêm Person</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="personForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div id="personFormError" class="alert alert-danger d-none"></div>
                    <div class="mb-3">
                        <label for="personId" class="form-label">Mã Person</label>
                        <input id="personId" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="personFullName" class="form-label">Họ và tên</label>
                        <input id="personFullName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label for="personAddress" class="form-label">Địa chỉ</label>
                        <input id="personAddress" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="savePersonButton">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/person-crud.js" asp-append-version="true"></script>
}

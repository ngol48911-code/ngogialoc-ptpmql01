@{
    ViewData["Title"] = "Quản lý Nhóm quyền";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý Nhóm quyền</h1>
    <button type="button" class="btn btn-primary" id="createRoleButton">Thêm nhóm quyền</button>
</div>

<div id="roleAlert" class="alert d-none" role="alert"></div>

<div class="row g-2 mb-3">
    <div class="col-md-10">
        <input id="roleSearch" class="form-control" placeholder="Tìm theo tên nhóm quyền..." />
    </div>
    <div class="col-md-2">
        <select id="rolePageSize" class="form-select" aria-label="Số dòng mỗi trang">
            <option value="5">5 dòng</option>
            <option value="10" selected>10 dòng</option>
            <option value="20">20 dòng</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tên nhóm quyền</th>
                <th>Tên chuẩn hóa</th>
                <th>Số người dùng</th>
                <th>Loại</th>
                <th>Quyền Action</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody id="roleTableBody">
            <tr>
                <td colspan="6" class="text-center">Đang tải dữ liệu...</td>
            </tr>
        </tbody>
    </table>
</div>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span id="rolePageInfo" class="text-muted"></span>
    <nav aria-label="Phân trang nhóm quyền">
        <ul id="rolePagination" class="pagination mb-0"></ul>
    </nav>
</div>

<div class="modal fade" id="roleModal" tabindex="-1" aria-labelledby="roleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="roleModalLabel">Thêm nhóm quyền</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="roleForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div id="roleFormError" class="alert alert-danger d-none"></div>
                    <div class="mb-3">
                        <label for="roleName" class="form-label">Tên nhóm quyền</label>
                        <input id="roleName" name="Name" class="form-control" maxlength="50" />
                        <div class="invalid-feedback" data-error-for="Name"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="saveRoleButton">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="permissionModal" tabindex="-1"
     aria-labelledby="permissionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="permissionModalLabel">Phân quyền Action</h5>
                    <div class="text-muted" id="permissionRoleName"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <form id="permissionForm" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div id="permissionFormError" class="alert alert-danger d-none"></div>
                    <div class="d-flex justify-content-end mb-3">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="toggleAllPermissions">
                            Chọn tất cả
                        </button>
                    </div>
                    <div id="permissionGroups" class="row g-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary" id="savePermissionsButton">Lưu quyền</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/role-crud.js" asp-append-version="true"></script>
}
